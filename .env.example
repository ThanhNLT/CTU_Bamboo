#
# Cấu hình docker compose. Máy dev KHÔNG cần tệp .env: thiếu biến nào thì dùng đúng giá trị mặc định
# ghi dưới đây. Triển khai thật: `cp .env.example .env`, đặt BAMBOO_ENV=production và đổi mọi giá trị
# đánh dấu [BẮT BUỘC]; hệ thống từ chối khởi động nếu còn giá trị mặc định
# (hướng dẫn đầy đủ: docs/van-hanh/trien-khai.md).

# --- Môi trường ------------------------------------------------------------------------------------
# development | production. production: openbao-init dừng nếu còn mật khẩu mặc định bên dưới.
BAMBOO_ENV=development

# --- Secret hạ tầng (openbao-init chép vào OpenBao; dịch vụ ứng dụng đọc từ két) -------------------
POSTGRES_PASSWORD=bms-dev                    # [BẮT BUỘC]
HASURA_GRAPHQL_ADMIN_SECRET=dev-admin-secret # [BẮT BUỘC] chuỗi ngẫu nhiên dài
ACTIONS_SECRET=dev-actions-secret            # [BẮT BUỘC] Hasura gửi kèm khi gọi Action
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev          # [BẮT BUỘC]
FLOWABLE_ADMIN=rest-admin
FLOWABLE_ADMIN_PASSWORD=test                 # [BẮT BUỘC]
# Khóa S3 không khai báo ở đây: OpenBao tự sinh một lần và là nguồn duy nhất.

# --- Dữ liệu demo -------------------------------------------------------------------------------------
# Mật khẩu chung của tài khoản demo trong realm Keycloak (import ở lần chạy đầu).
DEMO_PASSWORD=demo-password                  # [BẮT BUỘC]
# false: không nạp dữ liệu demo Tập đoàn X vào CSDL.
SEED_DEMO=true

# --- Địa chỉ công khai (trình duyệt thấy) -------------------------------------------------------------
# Production: tên miền HTTPS sau reverse proxy. Phải khớp nhau giữa các dịch vụ.
WEB_ORIGIN=http://localhost:5173             # ứng dụng web; CORS của Hasura và SeaweedFS
KEYCLOAK_URL=http://localhost:8080           # issuer token; cấu hình lúc chạy của web
HASURA_PUBLIC_URL=http://localhost:8081/v1/graphql
S3_PUBLIC_ENDPOINT=http://localhost:8333     # link tải tệp có chữ ký

# --- Chế độ chạy ----------------------------------------------------------------------------------------
# start-dev (máy dev) | start (production, sau reverse proxy TLS).
KEYCLOAK_MODE=start-dev
# Production: false (metadata Hasura quản lý trong Git, nạp bằng job bootstrap).
HASURA_ENABLE_CONSOLE=true

# --- Image dựng sẵn (compose.release.yml / oci://) ------------------------------------------------------
# Phiên bản image trên GHCR, ví dụ 0.1.0; để trống thì dùng phiên bản ghi trong tệp compose phát hành.
# BAMBOO_TAG=
# BAMBOO_IMAGE_PREFIX=ghcr.io/thanhnlt/bamboo

# --- Quét virus tệp đính kèm ------------------------------------------------------------------------
# `docker compose --profile scan up -d` và đặt CLAMAV_HOST=clamav.
CLAMAV_HOST=
