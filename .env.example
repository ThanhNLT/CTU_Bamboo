BAMBOO_ENV=development
# mTLS cho các chặng HTTP nội bộ (infra/compose/mtls.yml, ADR #76): để trống thì bật theo BAMBOO_ENV=production;
# true bật cả trên máy dev (cổng gỡ lỗi Keycloak 8080, Hasura 8081, Flowable 8082, actions 8090 đóng); false tắt.
BAMBOO_MTLS=
BAMBOO_GITOPS=true
GITOPS_BRANCH=main
GITOPS_INTERVAL_MINUTES=5
BAMBOO_PULL_POLICY=build

POSTGRES_PASSWORD=bms-dev
HASURA_DB_PASSWORD=hasura-db-dev
ACTIONS_DB_PASSWORD=actions-db-dev
KEYCLOAK_DB_PASSWORD=keycloak-db-dev
FLOWABLE_DB_PASSWORD=flowable-db-dev
CDC_DB_PASSWORD=cdc-db-dev
LAKEHOUSE_DB_PASSWORD=lakehouse-db-dev
HASURA_GRAPHQL_ADMIN_SECRET=dev-admin-secret
ACTIONS_SECRET=dev-actions-secret
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev
FLOWABLE_ADMIN=rest-admin
FLOWABLE_ADMIN_PASSWORD=test
DEBEZIUM_KAFKA_PASSWORD=debezium-kafka-dev
LAKEHOUSE_KAFKA_PASSWORD=lakehouse-kafka-dev

DEMO_PASSWORD=demo-password
SEED_DEMO=true

SIGNATURE_ONLINE=true
# Ký số văn bản PDF hệ thống phát hành (quyết định nhân sự, báo cáo KPI, phiếu đề nghị) bằng chứng thư số của tổ chức
# (ADR #94). Để trống: không ký. pkcs11: HSM/token qua thư viện PKCS#11 của hãng (SoftHSM2 có sẵn trong image actions:
# /usr/lib/softhsm/libsofthsm2.so); csc: dịch vụ ký số từ xa của CA chuẩn CSC API v1. PIN và bí mật OAuth2 đặt trong
# OpenBao: secret/bms/org-sign (khóa pin, csc_client_secret). Chỉ ký văn bản của công ty có mã số thuế trong chứng thư.
ORG_SIGN_PROVIDER=
ORG_SIGN_PKCS11_LIB=
ORG_SIGN_PKCS11_TOKEN=
ORG_SIGN_PKCS11_KEY=
ORG_SIGN_PKCS11_CERT=
ORG_SIGN_CSC_URL=
ORG_SIGN_CSC_CREDENTIAL=
ORG_SIGN_CSC_TOKEN_URL=
ORG_SIGN_CSC_CLIENT_ID=
# Dấu thời gian RFC 3161 (PAdES B-T), ví dụ máy chủ TSA của CA; để trống thì không gắn
ORG_SIGN_TSA_URL=
ORG_SIGN_LOCATION=
# Chứng thư riêng từng pháp nhân (nhiều công ty khác mã số thuế trong một cài đặt): JSON {mã số thuế: {pkcs11_token,
# pkcs11_key, csc_credential, ...}}, dùng chung thư viện PKCS#11 hoặc địa chỉ CSC ở trên. PIN riêng nên đặt trong
# OpenBao: khóa entities của secret/bms/org-sign (cùng định dạng JSON).
ORG_SIGN_ENTITIES=
SETUP_ALLOW_UNVERIFIED=true
SETUP_OPEN_SIGNUP=

GATEWAY_PORT=8000
WEB_ORIGIN=http://localhost:8000
KEYCLOAK_URL=http://localhost:8000
HASURA_PUBLIC_URL=http://localhost:8000/graphql
S3_PUBLIC_ENDPOINT=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
KEYCLOAK_ADMIN_URL=http://localhost:8080

KEYCLOAK_MODE=start-dev
HASURA_ENABLE_CONSOLE=false

CLAMAV_HOST=
BAMBOO_CLAMAV=

MQTT_BIND=127.0.0.1

BAMBOO_OBSERVABILITY=
GRAFANA_ADMIN_PASSWORD=grafana-dev
PROMETHEUS_RETENTION=7d

BAMBOO_RAM=
BAMBOO_CPU_LIMIT=
BAMBOO_GPU=
OCR_THREADS=
OCR_GPU_PRECISION=auto

AI_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_EMBED_MODEL=bge-m3
AI_MIN_SCORE=0.7
AI_STEP_TIMEOUT=600
AI_KEEP_ALIVE=5m
OCR_IDLE_SECONDS=300
AI_KV_CACHE_TYPE=

SLEEPER_IDLE_SECONDS=300
KEYCLOAK_HEAP=-Xms64m -Xmx512m
KEYCLOAK_DB_POOL=20
FLOWABLE_JAVA_OPTS=-Xms64m -Xmx512m
KAFKA_HEAP=-Xms128m -Xmx512m
DEBEZIUM_JAVA_OPTS=-Xms64m -Xmx384m
TIKA_JAVA_OPTS=-Xmx512m
MEILI_MAX_INDEXING_MEMORY=512 MiB
GATEWAY_WORKERS=2
