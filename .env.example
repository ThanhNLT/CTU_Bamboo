#
# Cấu hình docker compose. KHÔNG bắt buộc: thiếu .env thì dùng đúng các giá trị mặc định dưới đây
# (chỉ dành cho máy dev). Triển khai thật: `cp .env.example .env` rồi đổi mọi mật khẩu.
# Các secret này được openbao-init chép vào OpenBao; dịch vụ ứng dụng đọc từ két (ADR #25).
# Khóa S3 không khai báo ở đây: OpenBao tự sinh một lần.

POSTGRES_PASSWORD=bms-dev
HASURA_GRAPHQL_ADMIN_SECRET=dev-admin-secret
ACTIONS_SECRET=dev-actions-secret
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev
FLOWABLE_ADMIN=rest-admin
FLOWABLE_ADMIN_PASSWORD=test

# Mật khẩu chung của các tài khoản demo (import vào Keycloak ở lần chạy đầu).
DEMO_PASSWORD=demo-password
# false: không nạp dữ liệu demo Tập đoàn X.
SEED_DEMO=true

# Địa chỉ trình duyệt thấy: ứng dụng web (CORS của S3) và S3 (link tải tệp có chữ ký).
WEB_ORIGIN=http://localhost:5173
S3_PUBLIC_ENDPOINT=http://localhost:8333

# Quét virus tệp đính kèm: `docker compose --profile scan up -d` và đặt CLAMAV_HOST=clamav.
CLAMAV_HOST=
