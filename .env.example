BAMBOO_ENV=development
# build: `docker compose up` luôn dựng image Bamboo từ mã nguồn; missing: dùng image sẵn có, thiếu mới kéo/dựng
BAMBOO_PULL_POLICY=build

POSTGRES_PASSWORD=bms-dev
HASURA_DB_PASSWORD=hasura-db-dev
ACTIONS_DB_PASSWORD=actions-db-dev
KEYCLOAK_DB_PASSWORD=keycloak-db-dev
FLOWABLE_DB_PASSWORD=flowable-db-dev
CDC_DB_PASSWORD=cdc-db-dev
LAKEHOUSE_DB_PASSWORD=lakehouse-db-dev
HASURA_GRAPHQL_ADMIN_SECRET=dev-admin-secret
ACTIONS_SECRET=dev-actions-secret
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin-dev
FLOWABLE_ADMIN=rest-admin
FLOWABLE_ADMIN_PASSWORD=test
DEBEZIUM_KAFKA_PASSWORD=debezium-kafka-dev
LAKEHOUSE_KAFKA_PASSWORD=lakehouse-kafka-dev

DEMO_PASSWORD=demo-password
SEED_DEMO=true

# Khởi tạo công ty lần đầu (khi SEED_DEMO=false): kiểm thu hồi chứng thư số qua Internet; cho tạo công ty chưa xác thực
# pháp lý khi chưa ký được (ký bổ sung sau). Chứng thư gốc đặt ở infra/platform/trust rồi dựng lại image actions
SIGNATURE_ONLINE=true
SETUP_ALLOW_UNVERIFIED=true
# Mở trang đăng ký cả khi máy đã có công ty (bỏ trống: theo SEED_DEMO). Production: false
SETUP_OPEN_SIGNUP=

GATEWAY_PORT=8000
WEB_ORIGIN=http://localhost:8000
KEYCLOAK_URL=http://localhost:8000
HASURA_PUBLIC_URL=http://localhost:8000/graphql
S3_PUBLIC_ENDPOINT=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
KEYCLOAK_ADMIN_URL=http://localhost:8080

KEYCLOAK_MODE=start-dev
HASURA_ENABLE_CONSOLE=true

CLAMAV_HOST=
# ClamAV: bỏ trống = bật ở mức RAM 16 (make up), tắt ở mức 8; true/false để chọn tay
BAMBOO_CLAMAV=

# Broker MQTT cho thiết bị OT (ADR #74): mặc định chỉ nghe 127.0.0.1; đặt 0.0.0.0 để thiết bị trong mạng OT gửi được
MQTT_BIND=127.0.0.1

# Giám sát (ADR #75): bỏ trống = bật ở mức RAM 16, tắt ở mức 8; true/false để chọn tay
BAMBOO_OBSERVABILITY=
# [BẮT BUỘC] ở production: mật khẩu tài khoản admin của Grafana (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=grafana-dev
PROMETHEUS_RETENTION=7d

# Mức RAM cho `make up`: cả hai mức chạy đầy đủ gồm AI; 8 = tiết kiệm RAM (một mô hình AI mỗi lúc, dịch vụ ngủ sớm), 16 = mặc định; bỏ trống để tự chọn theo RAM Docker thấy được.
# `docker compose up` trực tiếp luôn chạy đầy đủ; Ollama, OCR ngủ khi nhàn rỗi và tự dậy khi có yêu cầu
BAMBOO_RAM=

AI_CHAT_MODEL=qwen3:4b
AI_EMBED_MODEL=bge-m3
AI_MIN_SCORE=0.7
AI_KEEP_ALIVE=5m
OCR_IDLE_SECONDS=300
AI_KV_CACHE_TYPE=q8_0

SLEEPER_IDLE_SECONDS=300
KEYCLOAK_HEAP=-Xms64m -Xmx512m
KEYCLOAK_DB_POOL=20
FLOWABLE_JAVA_OPTS=-Xms64m -Xmx512m
KAFKA_HEAP=-Xms128m -Xmx512m
DEBEZIUM_JAVA_OPTS=-Xms64m -Xmx384m
TIKA_JAVA_OPTS=-Xmx512m
MEILI_MAX_INDEXING_MEMORY=512 MiB
GATEWAY_WORKERS=2
