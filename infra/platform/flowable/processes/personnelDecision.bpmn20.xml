      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="par0_0_di" bpmnElement="par0_0">
        <dc:Bounds x="666" y="230" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="par0_1_di" bpmnElement="par0_1">
        <dc:Bounds x="666" y="125" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join0_di" bpmnElement="join0">
        <dc:Bounds x="916" y="245" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approved_di" bpmnElement="approved">
        <dc:Bounds x="1046" y="252" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1009" y="292" width="110" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rej_tongGiamDocKy_di" bpmnElement="rej_tongGiamDocKy">
        <dc:Bounds x="413" y="372" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="376" y="412" width="110" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ret_end_tongGiamDocKy_di" bpmnElement="ret_end_tongGiamDocKy">
        <dc:Bounds x="413" y="132" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="455" y="136" width="100" height="28"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="76" y="270"/>
        <di:waypoint x="156" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="326" y="270"/>
        <di:waypoint x="406" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
