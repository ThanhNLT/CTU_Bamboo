        <di:waypoint x="666" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="836" y="270"/>
        <di:waypoint x="916" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="586" y="270"/>
        <di:waypoint x="626" y="270"/>
        <di:waypoint x="626" y="165"/>
        <di:waypoint x="666" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
