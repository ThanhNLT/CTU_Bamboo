        <di:waypoint x="536" y="270"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="464" y="246" width="50" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
