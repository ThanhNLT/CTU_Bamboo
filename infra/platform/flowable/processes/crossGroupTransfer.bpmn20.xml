  <process id="crossGroupTransfer" name="Điều chuyển liên tập đoàn" isExecutable="true">
    <documentation>Ba chứng từ liên kết (đi, tiếp nhận, quyết định) gộp thành một chuỗi: tenant nguồn, tenant đích rồi tenant mẹ.</documentation>
    <startEvent id="start" name="Gửi đề nghị điều chuyển liên tập đoàn"/>
    <userTask id="qlNguon" name="Quản lý trực tiếp (tenant nguồn) duyệt" flowable:candidateGroups="QUAN_LY_TRUC_TIEP" flowable:dueDate="PT48H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_qlNguon" name="Quyết định?" default="ret_qlNguon"/>
    <userTask id="nsNguon" name="Nhân sự công ty nguồn duyệt" flowable:candidateGroups="TRUONG_PHONG_NHAN_SU" flowable:dueDate="PT48H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_nsNguon" name="Quyết định?" default="ret_nsNguon"/>
    <userTask id="donViDich" name="Đơn vị đích chọn vị trí tiếp nhận" flowable:candidateGroups="TRUONG_DON_VI_TIEP_NHAN" flowable:dueDate="PT48H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_donViDich" name="Quyết định?" default="ret_donViDich"/>
    <userTask id="nsDich" name="Nhân sự công ty đích duyệt" flowable:candidateGroups="TRUONG_PHONG_NHAN_SU" flowable:dueDate="PT48H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_nsDich" name="Quyết định?" default="ret_nsDich"/>
    <userTask id="nsTapDoan" name="Nhân sự tập đoàn ra quyết định" flowable:candidateGroups="TRUONG_PHONG_NHAN_SU_TAP_DOAN" flowable:dueDate="PT72H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_nsTapDoan" name="Quyết định?" default="ret_nsTapDoan"/>
    <serviceTask id="post0" name="Báo các bên liên quan" bamboo:action="notify" bamboo:audience="INITIATOR" bamboo:message="Điều chuyển liên tập đoàn đã được duyệt: bổ nhiệm ở tenant nguồn kết thúc, bổ nhiệm ở tenant đích bắt đầu"/>
    <endEvent id="approved" name="Đã duyệt, chuyển tenant"/>
    <endEvent id="rej_qlNguon" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_qlNguon" name="Trả về người lập"/>
    <endEvent id="rej_nsNguon" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_nsNguon" name="Trả về người lập"/>
    <endEvent id="rej_donViDich" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_donViDich" name="Trả về người lập"/>
    <endEvent id="rej_nsDich" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_nsDich" name="Trả về người lập"/>
    <endEvent id="rej_nsTapDoan" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_nsTapDoan" name="Trả về người lập"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="qlNguon"/>
    <sequenceFlow id="f2" sourceRef="qlNguon" targetRef="g_qlNguon"/>
    <sequenceFlow id="f3" sourceRef="g_qlNguon" targetRef="nsNguon" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f4" sourceRef="nsNguon" targetRef="g_nsNguon"/>
    <sequenceFlow id="f5" sourceRef="g_nsNguon" targetRef="donViDich" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f6" sourceRef="donViDich" targetRef="g_donViDich"/>
    <sequenceFlow id="f7" sourceRef="g_donViDich" targetRef="nsDich" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f8" sourceRef="nsDich" targetRef="g_nsDich"/>
    <sequenceFlow id="f9" sourceRef="g_nsDich" targetRef="nsTapDoan" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f10" sourceRef="nsTapDoan" targetRef="g_nsTapDoan"/>
    <sequenceFlow id="f11" sourceRef="g_nsTapDoan" targetRef="post0" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f12" sourceRef="post0" targetRef="approved"/>
    <sequenceFlow id="f13" sourceRef="g_qlNguon" targetRef="rej_qlNguon" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_qlNguon" sourceRef="g_qlNguon" targetRef="ret_end_qlNguon" name="Trả về"/>
    <sequenceFlow id="f15" sourceRef="g_nsNguon" targetRef="rej_nsNguon" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_nsNguon" sourceRef="g_nsNguon" targetRef="ret_end_nsNguon" name="Trả về"/>
    <sequenceFlow id="f17" sourceRef="g_donViDich" targetRef="rej_donViDich" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_donViDich" sourceRef="g_donViDich" targetRef="ret_end_donViDich" name="Trả về"/>
    <sequenceFlow id="f19" sourceRef="g_nsDich" targetRef="rej_nsDich" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_nsDich" sourceRef="g_nsDich" targetRef="ret_end_nsDich" name="Trả về"/>
    <sequenceFlow id="f21" sourceRef="g_nsTapDoan" targetRef="rej_nsTapDoan" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_nsTapDoan" sourceRef="g_nsTapDoan" targetRef="ret_end_nsTapDoan" name="Trả về"/>
  </process>

