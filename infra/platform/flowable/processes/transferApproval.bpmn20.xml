<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bamboo="http://bamboo.local/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="https://github.com/ThanhNLT/Bamboo/bpmn">
  <process id="transferApproval" name="Điều chuyển nhân sự nội bộ" isExecutable="true">
    <documentation>Chuỗi duyệt điều chuyển nội bộ (DC-…): trưởng đơn vị tiếp nhận rồi trưởng phòng nhân sự của công ty chung gần nhất; ngày chuyển cách ngày gửi ít nhất 14 ngày.</documentation>
    <startEvent id="start" name="Gửi đề nghị điều chuyển"/>
    <serviceTask id="pre" name="Thông báo đơn vị tiếp nhận" bamboo:action="notify" bamboo:audience="UNIT" bamboo:message="Có đề nghị điều chuyển nhân sự mới chờ đơn vị tiếp nhận xem xét"/>
    <userTask id="truongDonViDich" name="Đơn vị tiếp nhận xem xét, chọn vị trí" flowable:candidateGroups="TRUONG_DON_VI_TIEP_NHAN" flowable:dueDate="PT48H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_truongDonViDich" name="Quyết định?" default="ret_truongDonViDich"/>
    <userTask id="truongNhanSu" name="Trưởng phòng nhân sự duyệt" flowable:candidateGroups="TRUONG_PHONG_NHAN_SU" flowable:dueDate="PT72H" flowable:formKey="duyet_dieu_chuyen"/>
    <exclusiveGateway id="g_truongNhanSu" name="Quyết định?" default="ret_truongNhanSu"/>
    <serviceTask id="post0" name="Báo người lập và nhân viên" bamboo:action="notify" bamboo:audience="INITIATOR" bamboo:message="Điều chuyển đã được duyệt: bổ nhiệm cũ kết thúc trước ngày chuyển, bổ nhiệm mới bắt đầu từ ngày chuyển"/>
    <endEvent id="approved" name="Đã duyệt, điều chuyển"/>
    <endEvent id="rej_truongDonViDich" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_truongDonViDich" name="Trả về người lập"/>
    <endEvent id="rej_truongNhanSu" name="Từ chối điều chuyển"/>
    <endEvent id="ret_end_truongNhanSu" name="Trả về người lập"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="pre"/>
    <sequenceFlow id="f2" sourceRef="pre" targetRef="truongDonViDich"/>
    <sequenceFlow id="f3" sourceRef="truongDonViDich" targetRef="g_truongDonViDich"/>
    <sequenceFlow id="f4" sourceRef="g_truongDonViDich" targetRef="truongNhanSu" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f5" sourceRef="truongNhanSu" targetRef="g_truongNhanSu"/>
    <sequenceFlow id="f6" sourceRef="g_truongNhanSu" targetRef="post0" name="Duyệt">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'APPROVE'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f7" sourceRef="post0" targetRef="approved"/>
    <sequenceFlow id="f8" sourceRef="g_truongDonViDich" targetRef="rej_truongDonViDich" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_truongDonViDich" sourceRef="g_truongDonViDich" targetRef="ret_end_truongDonViDich" name="Trả về"/>
    <sequenceFlow id="f10" sourceRef="g_truongNhanSu" targetRef="rej_truongNhanSu" name="Từ chối">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${decision == 'REJECT'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="ret_truongNhanSu" sourceRef="g_truongNhanSu" targetRef="ret_end_truongNhanSu" name="Trả về"/>
  </process>

