# Giá trị mặc định của môi trường dev cho Secret bamboo-settings (overlay ci). Sinh bằng tools/k8s/generate.py.
ACTIONS_DB_PASSWORD=actions-db-dev
ACTIONS_SECRET=dev-actions-secret
AI_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_CPU_MODELS=bge-m3
AI_EMBED_MODEL=bge-m3
AI_KEEP_ALIVE=5m
AI_KV_CACHE_TYPE=q4_0
AI_MIN_SCORE=0.7
AI_STEP_TIMEOUT=600
BACKUP_FIRST_DELAY=600
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BAMBOO_ENV=development
CDC_DB_PASSWORD=cdc-db-dev
CLAMAV_HOST=
