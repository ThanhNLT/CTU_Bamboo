# Mặc định giao diện gọi Keycloak và Hasura cùng origin với trang (qua cổng API). Chỉ cần đặt các biến
# này (trong .env.local) khi backend ở địa chỉ khác; `npm run dev` đã có sẵn .env.development.
VITE_KEYCLOAK_URL=http://localhost:8000
VITE_KEYCLOAK_REALM=bms
VITE_KEYCLOAK_CLIENT=bms-web
VITE_HASURA_URL=http://localhost:8000/graphql
