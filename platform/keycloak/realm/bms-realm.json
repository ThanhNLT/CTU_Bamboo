      }
    ]
  },
  "clients": [
    {
      "clientId": "bms-web",
      "name": "Ứng dụng Refine",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${WEB_ORIGIN:http://localhost:8000}/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "${WEB_ORIGIN:http://localhost:8000}",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${WEB_ORIGIN:http://localhost:8000}/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "bms-e2e",
      "name": "Kiểm thử tự động (chỉ dev)",
