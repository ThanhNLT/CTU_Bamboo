{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "format:check": {},
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CI", "DEMO_PASSWORD", "DEMO_SHOTS", "E2E_*", "PLAYWRIGHT_*"]
    }
  }
}
